datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// =========================================================================
// 1. ROLES
// =========================================================================
model Rol {
  id_rol       Int                 @id @default(autoincrement())
  nombre_rol   String              @db.VarChar(50)
  
  // Relaciones
  trabajadores Trabajador[]
  funciones    RolesFuncionalidades[]

  @@map("roles")
}

// =========================================================================
// 2. FUNCIONALIDADES
// =========================================================================
model Funcionalidad {
  id_func     Int                 @id @default(autoincrement())
  nombre_func String              @db.VarChar(100)
  descripcion String?             @db.Text
  
  // Relaciones
  roles       RolesFuncionalidades[]

  @@map("funcionalidades")
}

// =========================================================================
// 3. ROLES _ FUNCIONALIDADES (Tabla Puente)
// =========================================================================
model RolesFuncionalidades {
  id_rol    Int
  id_func   Int
  activo    Boolean @default(true)

  // Relaciones
  rol           Rol           @relation(fields: [id_rol], references: [id_rol], onDelete: Cascade)
  funcionalidad Funcionalidad @relation(fields: [id_func], references: [id_func], onDelete: Cascade)

  @@id([id_rol, id_func]) // Llave primaria compuesta
  @@map("roles_funcionalidades")
}

// =========================================================================
// 4. TRABAJADORES
// =========================================================================
model Trabajador {
  id_trabajador         Int      @id @default(autoincrement())
  nombre                String   @db.VarChar(50)
  apellido              String   @db.VarChar(50)
  contrasena_hash       String   @db.VarChar(255)
  hash_huella           String?  @unique @db.VarChar(255) // Permite nulo si no tiene huella cargada aún
  id_rol                Int
  permiso_manejo_caja   Boolean  @default(false)
  limite_retiro_diario  Decimal  @db.Decimal(10, 2)
  fecha_registro        DateTime @default(now()) @db.Date

  // Relaciones
  rol                     Rol                 @relation(fields: [id_rol], references: [id_rol])
  cajas_apertura          Caja[]              @relation("TrabajadorApertura")
  cajas_cierre            Caja[]              @relation("TrabajadorCierre")
  sesiones                SesionVendedor[]
  ventas                  Venta[]
  movimientos_registrados MovimientoCaja[]
  arqueos_realizados      ArqueoCaja[]
  cambios_stock           HistorialStock[]
  logs_huella             LogVentasHuella[]

  @@map("trabajadores")
}

// =========================================================================
// 5. PRODUCTOS
// =========================================================================
model Producto {
  id_producto         Int      @id @default(autoincrement())
  codigo_barras       String   @unique @db.VarChar(50)
  nombre_producto     String   @db.VarChar(100)
  precio_unitario     Decimal  @db.Decimal(10, 2)
  costo_unitario      Decimal  @db.Decimal(10, 2)
  stock_actual        Int      @default(0)
  stock_minimo        Int      @default(0)
  ubicacion_almacen   String?  @db.VarChar(50)
  fecha_ultima_compra DateTime? @db.Date

  // Relaciones
  impuestos      ProductosImpuestos[]
  detalles_venta DetalleVenta[]
  historial_stock HistorialStock[]

  @@map("productos")
}

// =========================================================================
// 6. IMPUESTOS
// =========================================================================
model Impuesto {
  id_impuesto       Int     @id @default(autoincrement())
  nombre_impuesto   String  @db.VarChar(50)
  porcentaje        Decimal @db.Decimal(5, 2)
  aplica_a_producto Boolean @default(true)
  aplica_a_servicio Boolean @default(false)

  // Relaciones
  productos ProductosImpuestos[]

  @@map("impuestos")
}

// =========================================================================
// 7. PRODUCTOS _ IMPUESTOS (Tabla Puente)
// =========================================================================
model ProductosImpuestos {
  id_producto Int
  id_impuesto Int

  // Relaciones
  producto Producto @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)
  impuesto Impuesto @relation(fields: [id_impuesto], references: [id_impuesto], onDelete: Cascade)

  @@id([id_producto, id_impuesto]) // Llave primaria compuesta
  @@map("productos_impuestos")
}

// =========================================================================
// 8. CAJAS y ENUMS asociados
// =========================================================================
enum EstadoCaja {
  abierta
  cerrada
  auditoria
}

enum ModoAutenticacion {
  sesion_inicial
  por_venta
}

model Caja {
  id_caja                Int               @id @default(autoincrement())
  id_trabajador_apertura Int
  fecha_hora_apertura    DateTime          @default(now()) @db.Timestamp
  monto_inicial          Decimal           @db.Decimal(10, 2)
  id_trabajador_cierre   Int?
  fecha_hora_cierre      DateTime?         @db.Timestamp
  monto_final_expected   Decimal           @db.Decimal(10, 2)
  monto_final_real       Decimal?          @db.Decimal(10, 2)
  estado                 EstadoCaja        @default(abierta)
  modo_autenticacion     ModoAutenticacion

  // Relaciones
  trabajador_apertura Trabajador       @relation("TrabajadorApertura", fields: [id_trabajador_apertura], references: [id_trabajador])
  trabajador_cierre   Trabajador?      @relation("TrabajadorCierre", fields: [id_trabajador_cierre], references: [id_trabajador])
  sesiones            SesionVendedor[]
  ventas              Venta[]
  movimientos         MovimientoCaja[]
  arqueos             ArqueoCaja[]

  @@map("cajas")
}

// =========================================================================
// 9. SESIONES _ VENDEDOR
// =========================================================================
model SesionVendedor {
  id_sesion         Int       @id @default(autoincrement())
  id_caja           Int
  id_trabajador     Int
  fecha_hora_inicio DateTime  @default(now()) @db.Timestamp
  fecha_hora_fin    DateTime? @db.Timestamp

  // Relaciones
  caja       Caja       @relation(fields: [id_caja], references: [id_caja])
  trabajador Trabajador @relation(fields: [id_trabajador], references: [id_trabajador])

  @@map("sesiones_vendedor")
}

// =========================================================================
// 10. VENTAS
// =========================================================================
model Venta {
  id_venta      Int      @id @default(autoincrement())
  fecha_hora    DateTime @default(now()) @db.Timestamp
  id_trabajador Int
  id_caja       Int
  total_neto    Decimal  @db.Decimal(10, 2)
  impuestos     Decimal  @db.Decimal(10, 2)
  total_bruto   Decimal  @db.Decimal(10, 2)
  cambio_total  Decimal  @default(0.00) @db.Decimal(10, 2)

  // Relaciones
  trabajador       Trabajador         @relation(fields: [id_trabajador], references: [id_trabajador])
  caja             Caja               @relation(fields: [id_caja], references: [id_caja])
  detalles_pago    DetallePagoVenta[]
  detalles_articul DetalleVenta[]
  movimientos_caja MovimientoCaja[]
  historial_stock  HistorialStock[]
  logs_huella      LogVentasHuella[]

  @@map("ventas")
}

// =========================================================================
// 11. METODOS _ PAGO
// =========================================================================
model MetodoPago {
  id_metodo_pago Int     @id @default(autoincrement())
  nombre_metodo  String  @db.VarChar(50) // Efectivo, Tarjeta, etc.
  requiere_cambio Boolean @default(false)

  // Relaciones
  detalles_pago DetallePagoVenta[]

  @@map("metodos_pago")
}

// =========================================================================
// 12. DETALLE _ PAGO _ VENTA
// =========================================================================
model DetallePagoVenta {
  id_detalle_pago Int      @id @default(autoincrement())
  id_venta        Int
  id_metodo_pago  Int
  monto           Decimal  @db.Decimal(10, 2)
  cambio_devuelto Decimal? @db.Decimal(10, 2)

  // Relaciones
  venta       Venta      @relation(fields: [id_venta], references: [id_venta], onDelete: Cascade)
  metodo_pago MetodoPago @relation(fields: [id_metodo_pago], references: [id_metodo_pago])

  @@map("detalle_pago_venta")
}

// =========================================================================
// 13. DETALLE _ VENTAS
// =========================================================================
model DetalleVenta {
  id_detalle             Int     @id @default(autoincrement())
  id_venta               Int
  id_producto            Int
  cantidad               Int
  precio_unitario_moment Decimal @db.Decimal(10, 2)

  // Relaciones
  venta    Venta    @relation(fields: [id_venta], references: [id_venta], onDelete: Cascade)
  producto Producto @relation(fields: [id_producto], references: [id_producto])

  @@map("detalle_ventas")
}

// =========================================================================
// 14. MOVIMIENTOS _ CAJA
// =========================================================================
enum TipoMovimiento {
  ingreso_venta
  ingreso_ajuste
  egreso_retiro
  egreso_ajuste_negativo
  apertura
  cierre
}

model MovimientoCaja {
  id_movimiento          Int            @id @default(autoincrement())
  id_caja                Int
  fecha_hora             DateTime       @default(now()) @db.Timestamp
  tipo_movimiento        TipoMovimiento
  id_venta               Int?
  monto                  Decimal        @db.Decimal(10, 2)
  descripcion            String         @db.VarChar(255)
  id_trabajador_registra Int

  // Relaciones
  caja                Caja       @relation(fields: [id_caja], references: [id_caja])
  venta               Venta?     @relation(fields: [id_venta], references: [id_venta])
  trabajador_registra Trabajador @relation(fields: [id_trabajador_registra], references: [id_trabajador])

  @@map("movimientos_caja")
}

// =========================================================================
// 15. ARQUEOS _ CAJA
// =========================================================================
model ArqueoCaja {
  id_arqueo             Int      @id @default(autoincrement())
  id_caja               Int
  fecha_hora            DateTime @default(now()) @db.Timestamp
  monto_contado_fisico  Decimal  @db.Decimal(10, 2)
  monto_segun_sistema   Decimal  @db.Decimal(10, 2) // Aquí puedes mapear la suma de crédito/débito/efectivo desde tu backend
  diferencia            Decimal  @db.Decimal(10, 2)
  id_trabajador_realiza Int
  observaciones         String?  @db.Text

  // Relaciones
  caja               Caja       @relation(fields: [id_caja], references: [id_caja])
  trabajador_realiza Trabajador @relation(fields: [id_trabajador_realiza], references: [id_trabajador])

  @@map("arqueos_caja")
}

// =========================================================================
// 16. HISTORIAL _ STOCK
// =========================================================================
enum MotivoCambioStock {
  venta
  compra_proveedor
  ajuste_inventario
  devolucion
  merma
}

model HistorialStock {
  id_historial_stock Int               @id @default(autoincrement())
  id_producto        Int
  fecha_hora         DateTime          @default(now()) @db.Timestamp
  cantidad_anterior  Int
  cantidad_nueva     Int
  id_trabajador      Int
  motivo             MotivoCambioStock
  id_venta           Int?

  // Relaciones
  producto   Producto   @relation(fields: [id_producto], references: [id_producto])
  trabajador Trabajador @relation(fields: [id_trabajador], references: [id_trabajador])
  venta      Venta?     @relation(fields: [id_venta], references: [id_venta])

  @@map("historial_stock")
}

// =========================================================================
// 17. ESTADISTICAS _ MENSUALES
// =========================================================================
model EstadisticaMensual {
  id_estadistica            Int     @id @default(autoincrement())
  anio                      Int     @map("año") // Mapea "anio" en Prisma al campo "año" de la DB para evitar caracteres especiales
  mes                       Int     // 1-12
  total_ventas_mes          Decimal @db.Decimal(12, 2)
  cantidad_transacciones    Int
  productos_vendidos_total  Int

  @@map("estadisticas_mensuales")
}

// =========================================================================
// 18. LOG _ VENTAS _ HUELLA
// =========================================================================
model LogVentasHuella {
  id_log            Int      @id @default(autoincrement())
  id_venta          Int
  id_trabajador     Int
  timestamp_huella  DateTime @default(now()) @db.Timestamp
  ip_terminal       String   @db.VarChar(45) // Soporta IPv4 e IPv6

  // Relaciones
  venta      Venta      @relation(fields: [id_venta], references: [id_venta], onDelete: Cascade)
  trabajador Trabajador @relation(fields: [id_trabajador], references: [id_trabajador])

  @@map("log_ventas_huella")
}